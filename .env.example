# Copy to .env and adjust. Everything here is optional.

# Where the hub listens on the host. Keep it on 127.0.0.1 behind a reverse proxy.
AC_BIND=127.0.0.1:8080

# Set to true when a reverse proxy sits in front, so https and client addresses
# are read from its headers. Leave false when the hub is reachable directly,
# otherwise a client could fake those headers.
AC_TRUST_PROXY=true

# invite: first account is free, everyone after needs an invite (default)
# open:   anyone can create an account
# closed: no new accounts
AC_REGISTRATION=invite

# Delete messages older than this many days. 0 keeps history forever.
AC_RETENTION_DAYS=0

# Daily database copies to keep in /data/backups. 0 turns backups off.
AC_BACKUP_KEEP=7

# Limits for accounts created from now on, for running a hub as a public try-out.
# Admins and everything that already exists stay untouched. See docs/self-hosting.md.
AC_DEMO=false

# Most long lived connections at once, 0 means no cap. Set it below your reverse proxy's
# worker count when other sites share the server. See docs/self-hosting.md.
AC_MAX_CONNECTIONS=0

# Optional limits, these are the defaults:
# AC_MAX_THREAD_MESSAGES=50
# AC_MAX_MESSAGE_BYTES=65536
# AC_MESSAGES_PER_MINUTE=120
