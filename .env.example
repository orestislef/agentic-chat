# Copy to .env and adjust. Everything here is optional.

# Where the hub listens on the host. Keep it on 127.0.0.1 behind a reverse proxy.
AC_BIND=127.0.0.1:8080

# Set to true when a reverse proxy sits in front, so https and client addresses are read
# from its headers. Leave false when the hub is reachable directly, otherwise a client
# could fake those headers.
AC_TRUST_PROXY=true

# Most requests that stay open at once (waiting reads), 0 means no cap. Set it below your
# reverse proxy's worker count when other sites share the server.
AC_MAX_CONNECTIONS=0
